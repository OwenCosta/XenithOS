#!/usr/bin/env python3
"""A stand-in for `java -Xmx... -jar server.jar nogui`, so HostMC can be tried in the simulator
(sim/run.sh with XSIM_HOSTMC=1) with nothing downloaded and no Java.

It says what a Minecraft server says, in the same log format: starting up, Done, two players
joining (Steve, then Alex, who leaves after a while), a line of chat, and answers to the commands
HostMC sends through its standard input (list, say, save-all, op, whitelist, stop and more).
It keeps ops.json and whitelist.json like the server does, makes a small world folder, refuses
to start without eula=true in eula.txt, and saves and stops on "stop" or SIGTERM.

It answers a server list ping on its port (on server-ip, or 127.0.0.1 when that's empty), as
Minecraft does, so a route to the server (HostMC's own-VPS tunnel) can be checked; anyone trying to
join is turned away politely.

Like Paper with proxies.proxy-protocol on in config/paper-global.yml (which HostMC turns on for
players' real addresses through its supporter relay), it then wants a PROXY protocol header, v2 or
v1, at the start of every connection, takes the player's address from it, and closes a connection
without one. Who each connection was from goes in connections.log ("status 203.0.113.7",
"join ...", "no PROXY header from ..."), for tests.

HOSTMC_FAKE_PLAYERS="Steve,Alex" changes who joins ("" for nobody).
"""
import json
import os
import re
import signal
import socket
import sys
import threading
import time

lock = threading.Lock()
stopping = threading.Event()
online = []
start = time.time()


def log(level, msg, thread="Server thread"):
    with lock:
        print("[%s] [%s/%s]: %s" % (time.strftime("%H:%M:%S"), thread, level, msg), flush=True)


def say(msg):
    """What the server tells everyone: Minecraft 26 logs it as "System chat: ..."."""
    log("INFO", "System chat: " + msg)


def props():
    out = {}
    try:
        with open("server.properties", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def names_file(path, change):
    try:
        with open(path, encoding="utf-8") as f:
            entries = json.load(f)
    except (OSError, ValueError):
        entries = []
    entries = change(entries)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(entries, f, indent=2)


def entry(name):
    return {"uuid": "00000000-0000-4000-8000-%012d" % (abs(hash(name)) % 10 ** 12), "name": name}


def leave(name, why="Disconnected"):
    if name in online:
        online.remove(name)
        log("INFO", "%s lost connection: %s" % (name, why))
        say("%s left the game" % name)


def command(cmd):
    p = props()
    words = cmd.split()
    if not words:
        return
    verb, rest = words[0].lower(), words[1:]
    if verb == "stop":
        stopping.set()
    elif verb == "list":
        say("There are %d of a max of %s players online: %s" % (len(online), p.get("max-players", "20"), ", ".join(online)))
    elif verb == "say":
        log("INFO", "[Server] " + " ".join(rest))
    elif verb == "save-all":
        say("Saving the game (this may take a moment!)")
        time.sleep(0.3)
        say("Saved the game")
    elif verb == "save-off":
        say("Automatic saving is now disabled")
    elif verb == "save-on":
        say("Automatic saving is now enabled")
    elif verb == "time" and rest[:2] == ["set", "day"]:
        say("Set the time to 1000")
    elif verb == "weather" and rest:
        say("Set the weather to " + rest[0])
    elif verb == "difficulty" and rest:
        say("The difficulty has been set to " + rest[0].capitalize())
    elif verb == "defaultgamemode" and rest:
        say("The default game mode is now " + rest[0].capitalize() + " Mode")
    elif verb in ("op", "deop") and rest:
        name = rest[0]
        names_file("ops.json", (lambda e: e + [dict(entry(name), level=4, bypassesPlayerLimit=False)]) if verb == "op"
                   else (lambda e: [x for x in e if x["name"] != name]))
        say(("Made %s a server operator" if verb == "op" else "Made %s no longer a server operator") % name)
    elif verb == "whitelist" and rest:
        if rest[0] in ("on", "off"):
            say("Whitelist is now turned " + rest[0])
        elif rest[0] == "reload":
            say("Reloaded the whitelist")
        elif rest[0] in ("add", "remove") and len(rest) > 1:
            name = rest[1]
            names_file("whitelist.json", (lambda e: e + [entry(name)]) if rest[0] == "add"
                       else (lambda e: [x for x in e if x["name"] != name]))
            say(("Added %s to the whitelist" if rest[0] == "add" else "Removed %s from the whitelist") % name)
    elif verb in ("kick", "ban") and rest:
        name = rest[0]
        if verb == "ban":
            say("Banned %s: Banned by an operator." % name)
        else:
            say("Kicked %s: Kicked by an operator" % name)
        leave(name, "Kicked by an operator")
    else:
        log("INFO", "Unknown or incomplete command, see below for error")
        log("INFO", cmd + "<--[HERE]")


def varint(n):
    n &= 0xFFFFFFFF
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        out.append(b | 0x80 if n else b)
        if not n:
            return bytes(out)


def read_varint(conn):
    n = shift = 0
    while True:
        b = conn.recv(1)
        if not b:
            raise EOFError
        n |= (b[0] & 0x7F) << shift
        shift += 7
        if not b[0] & 0x80:
            return n


def read_packet(conn):
    length = read_varint(conn)
    data = b""
    while len(data) < length:
        chunk = conn.recv(length - len(data))
        if not chunk:
            raise EOFError
        data += chunk
    return data


def packet(pid, data):
    body = varint(pid) + data
    return varint(len(body)) + body


def mc_string(s):
    b = s.encode("utf-8")
    return varint(len(b)) + b


PROXY_V2 = b"\r\n\r\n\x00\r\nQUIT\n"


def proxy_protocol():
    """proxies.proxy-protocol in config/paper-global.yml, as Paper reads it."""
    try:
        with open(os.path.join("config", "paper-global.yml"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return False
    m = re.search(r"^proxies:[ \r]*\n((?:[ \t].*\n|[ \t]*\n|#.*\n)*)", text + "\n", re.M)
    return bool(m and re.search(r"^  proxy-protocol:[ \t]*true[ \t\r]*$", m.group(1), re.M))


def read_exact(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise EOFError
        data += chunk
    return data


def read_proxy(conn):
    """The player's (address, port) from the PROXY header the connection starts with, or None."""
    head = read_exact(conn, 16)
    if head[:12] == PROXY_V2:
        body = read_exact(conn, int.from_bytes(head[14:16], "big"))
        if head[12] != 0x21:
            return None                            # LOCAL: no player to name
        if head[13] == 0x11 and len(body) >= 12:
            return socket.inet_ntop(socket.AF_INET, body[0:4]), int.from_bytes(body[8:10], "big")
        if head[13] == 0x21 and len(body) >= 36:
            return socket.inet_ntop(socket.AF_INET6, body[0:16]), int.from_bytes(body[32:34], "big")
        return None
    if head.startswith(b"PROXY "):                 # version 1: one line of text
        line = head
        while not line.endswith(b"\r\n") and len(line) < 108:
            line += read_exact(conn, 1)
        parts = line.decode("ascii", "replace").split()
        if len(parts) == 6:
            return parts[2], int(parts[4])
    return None


def note(what, who):
    with lock:
        with open("connections.log", "a", encoding="utf-8") as f:
            f.write("%s %s\n" % (what, who[0]))


def answer(conn):
    """One connection: a server list ping answered, or someone trying to join turned away."""
    try:
        conn.settimeout(5)
        who = conn.getpeername()[:2]
        if proxy_protocol():
            got = read_proxy(conn)
            if not got:
                note("no PROXY header from", who)
                return
            who = got
        handshake = read_packet(conn)          # id, protocol, address, port, next state
        if handshake[-1] == 1:
            note("status", who)
            read_packet(conn)                  # the status request
            p = props()
            status = {"version": {"name": "26.3", "protocol": 777},
                      "players": {"max": int(p.get("max-players") or 20), "online": len(online)},
                      "description": {"text": p.get("motd") or "A Minecraft Server"}}
            conn.sendall(packet(0, mc_string(json.dumps(status))))
            ping = read_packet(conn)           # the ping, sent back as the pong
            conn.sendall(varint(len(ping)) + ping)
        else:
            note("join", who)
            reason = {"text": "This is HostMC's stand-in server: there's no world to join."}
            log("INFO", "/%s:%d lost connection: %s" % (who[0], who[1], reason["text"]), "Server thread")
            conn.sendall(packet(0, mc_string(json.dumps(reason))))
    except (OSError, EOFError, IndexError, ValueError):
        pass
    finally:
        conn.close()


def listen(port, host):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind((host, port))
    except OSError:
        log("WARN", "The stand-in can't listen on port %d, so it won't answer pings" % port)
        return
    srv.listen(8)
    srv.settimeout(0.5)
    while not stopping.is_set():
        try:
            conn, _ = srv.accept()
        except socket.timeout:
            continue
        except OSError:
            break
        threading.Thread(target=answer, args=(conn,), daemon=True).start()
    srv.close()


def console():
    for line in sys.stdin:
        line = line.strip()
        if line:
            command(line)
    # HostMC keeps the pipe open for writing too, so this only ends if it's gone.


def main():
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    log("INFO", "Environment: Environment[sessionHost=https://sessionserver.mojang.com, name=PROD]", "ServerMain")
    try:
        with open("eula.txt", encoding="utf-8") as f:
            agreed = "eula=true" in f.read()
    except OSError:
        agreed = False
    if not agreed:
        log("INFO", "You need to agree to the EULA in order to run the server. Go to eula.txt for more info.", "ServerMain")
        return 0
    p = props()
    port = p.get("server-port", "25565")
    time.sleep(0.6)
    log("INFO", "Starting minecraft server version 26.3")
    log("INFO", "Loading properties")
    log("INFO", "Default game type: " + p.get("gamemode", "survival").upper())
    log("INFO", "Generating keypair")
    log("INFO", "Starting Minecraft server on %s:%s" % (p.get("server-ip") or "*", port))
    if proxy_protocol():
        log("WARN", "Using HAProxy, please ensure the server port is adequately firewalled.")
    threading.Thread(target=listen, args=(int(port) if port.isdigit() else 25565, p.get("server-ip") or "127.0.0.1"),
                     daemon=True).start()
    log("INFO", "Using epoll channel type", "Server thread")
    level = p.get("level-name", "world") or "world"
    os.makedirs(os.path.join(level, "region"), exist_ok=True)
    for name, size in (("level.dat", 1500), (os.path.join("region", "r.0.0.mca"), 24576)):
        path = os.path.join(level, name)
        if not os.path.exists(path):
            with open(path, "wb") as f:
                f.write(os.urandom(size))
    log("INFO", 'Preparing level "%s"' % level)
    for pct in (0, 34, 71, 100):
        time.sleep(0.4)
        log("INFO", "Preparing spawn area: %d%%" % pct, "Worker-Main-1")
    log("INFO", 'Done (%.3fs)! For help, type "help"' % (time.time() - start))
    threading.Thread(target=console, daemon=True).start()

    players = [n for n in os.environ.get("HOSTMC_FAKE_PLAYERS", "Steve,Alex").split(",") if n]
    plan = []
    for i, name in enumerate(players):
        plan.append((3.0 + 3.0 * i, "join", name))
    if players:
        plan.append((9.0, "chat", players[0]))
    if len(players) > 1:
        plan.append((60.0, "leave", players[1]))
    plan.sort()
    ready = time.time()
    while not stopping.is_set():
        t = time.time() - ready
        while plan and plan[0][0] <= t:
            _, what, name = plan.pop(0)
            if what == "join":
                log("INFO", "UUID of player %s is %s" % (name, entry(name)["uuid"]), "User Authenticator #1")
                log("INFO", "%s[/192.168.1.24:5%04d] logged in with entity id %d at (8.5, 70.0, -3.5)" % (name, len(online), 112 + len(online)))
                online.append(name)
                say("%s joined the game" % name)
            elif what == "chat":
                log("INFO", "<%s> hi! the server works" % name)
            elif what == "leave":
                leave(name)
        stopping.wait(0.1)

    say("Stopping the server")
    log("INFO", "Stopping server")
    log("INFO", "Saving players")
    for name in list(online):
        leave(name, "Server closed")
    log("INFO", "Saving worlds")
    time.sleep(0.4)
    log("INFO", "Saving chunks for level 'ServerLevel[%s]'/minecraft:overworld" % level)
    log("INFO", "ThreadedAnvilChunkStorage (%s): All chunks are saved" % level)
    log("INFO", "ThreadedAnvilChunkStorage: All dimensions are saved")
    return 0


if __name__ == "__main__":
    sys.exit(main())
