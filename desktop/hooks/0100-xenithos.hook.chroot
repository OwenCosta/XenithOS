#!/bin/sh
# Builds XenithOS Console and its apps from the source build.sh put in /usr/src/xenithos, and
# installs the programs where linux/install.sh does. Which programs there are comes from
# linux/Makefile's "all" (XenithOS itself, then its apps), so an app added there comes along by
# itself. The session scripts and menu entries are XenithOS Desktop's own (the xenithos-desktop
# package), not linux/'s: here the PC starts in the desktop. The account XenithOS runs as doesn't
# exist yet: the live session (usr/lib/live/config/2000-xenithos) and the installer set it up
# with /usr/lib/xenithos-desktop/setup-user, which reads the list of apps that come on the home
# screen from /usr/share/xenithos/apps.list.
set -e
SRC=/usr/src/xenithos
PROGRAMS=$(sed -n 's/^all:[[:space:]]*//p' "$SRC/linux/Makefile")
case " $PROGRAMS " in
    *" xenithos "*) ;;
    *) echo "linux/Makefile's all: doesn't list xenithos ($PROGRAMS)" >&2; exit 1 ;;
esac

# shellcheck disable=SC2086
make -C "$SRC/linux" -j"$(nproc)" $PROGRAMS

# The apps people install themselves (Settings > Console apps) are built and put in place like
# the rest, but left out of apps.list, so they aren't on a new account's home screen.
OPTIONAL=$(sed -n 's/^\([a-z0-9][a-z0-9_-]*\).*/\1/p' /usr/share/xenithos-desktop/console-apps.list 2>/dev/null | tr '\n' ' ')

install -d /usr/lib/xenithos /usr/share/xenithos/apps
: > /usr/share/xenithos/apps.list
for p in $PROGRAMS; do
    install -m 755 "$SRC/linux/$p" /usr/lib/xenithos/
    [ "$p" = xenithos ] && continue
    case " $OPTIONAL " in
        *" $p "*) ;;
        *) echo "$p" >> /usr/share/xenithos/apps.list ;;
    esac
    if [ -f "$SRC/art/thumbs/$p.ximg" ]; then install -m 644 "$SRC/art/thumbs/$p.ximg" /usr/share/xenithos/apps/; fi
    if [ -f "$SRC/apps/$p/app.txt" ]; then install -m 644 "$SRC/apps/$p/app.txt" "/usr/share/xenithos/apps/$p.txt"; fi
done

rm -rf "$SRC"
