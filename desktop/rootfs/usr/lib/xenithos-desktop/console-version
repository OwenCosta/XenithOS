#!/bin/sh
# Prints XenithOS Console's version, read from its program (it says "Version 0.6.1" on its
# start-up screen).
B=/usr/lib/xenithos/xenithos
[ -f "$B" ] || { echo "not installed"; exit 1; }
v=$(grep -aoE 'Version [0-9]+\.[0-9]+(\.[0-9]+)?' "$B" | head -n 1 | cut -d' ' -f2)
echo "${v:-unknown}"
