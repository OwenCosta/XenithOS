#!/usr/bin/env python3
"""A yes-or-no question in XenithOS's look, for scripts.

    ask TITLE TEXT [YES [NO]] [--danger]      exit code 0 for yes, 1 for no

With NO given as "" there's only the one button: something to be told, not asked.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import xui  # noqa: E402

args = [a for a in sys.argv[1:] if a != "--danger"]
if len(args) < 2:
    sys.exit(2)
yes = args[2] if len(args) > 2 else "OK"
no = args[3] if len(args) > 3 else "Not now"
sys.exit(0 if xui.ask(args[0], args[1], yes, no, danger="--danger" in sys.argv) else 1)
