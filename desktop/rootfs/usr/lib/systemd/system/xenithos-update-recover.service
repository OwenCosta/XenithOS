[Unit]
Description=Finish a XenithOS Desktop update that was cut off
ConditionPathExists=/var/lib/xenithos-desktop/update-running
After=local-fs.target
Before=getty@tty1.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/lib/xenithos-desktop/update-helper recover
TimeoutStartSec=20min
StandardOutput=null

[Install]
WantedBy=multi-user.target
