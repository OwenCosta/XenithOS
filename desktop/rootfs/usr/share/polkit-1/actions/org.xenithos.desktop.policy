<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>XenithOS</vendor>
  <vendor_url>https://owencosta.diy/xenithos/</vendor_url>
  <action id="org.xenithos.desktop.security">
    <description>Change this PC's security settings</description>
    <message>Type your password to change this PC's security settings</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/xenithos-desktop/security-helper</annotate>
  </action>
</policyconfig>
