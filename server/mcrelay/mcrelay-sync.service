# HostMC's supporter relay: the names, ports and keys from XenithOS Cloud every 30 seconds
# (see mcrelay.py). Runs as the tunnel account, which owns the authorized_keys it writes.
# setup.sh installs it.
[Unit]
Description=HostMC supporter relay: names from XenithOS Cloud
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/mcrelay/mcrelay.py sync
EnvironmentFile=/etc/mcrelay/mcrelay.env
Environment=MCRELAY_DIR=/var/lib/mcrelay
Environment=MCRELAY_SECRET_FILE=/etc/mcrelay/secret
Environment=MCRELAY_HOSTKEY=/etc/mcrelay/ssh_host_ed25519_key.pub
User=hostmc
Group=hostmc
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcrelay
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX: name lookups for XenithOS Cloud's address
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=128M

[Install]
WantedBy=multi-user.target
