# HostMC's supporter relay: players on :25565, each passed to the server their name is for
# (see mcrelay.py). setup.sh installs it.
[Unit]
Description=HostMC supporter relay: players on :25565
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/mcrelay/mcrelay.py router
Environment=MCRELAY_LISTEN=0.0.0.0:25565
Environment=MCRELAY_DIR=/var/lib/mcrelay
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
LimitNOFILE=16384
MemoryMax=512M

[Install]
WantedBy=multi-user.target
